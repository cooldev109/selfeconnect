// TipVan backend schema. Field names mirror the frontend's TypeScript types
// (Driver / Tip) so the API can return shapes the UI already expects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  driver
  admin
}

enum SubscriptionStatus {
  none
  trialing
  active
  past_due
  canceled
}

enum TipStatus {
  pending
  succeeded
  failed
  refunded
}

enum JobStatus {
  open
  closed
}

// Whether a service-seeker account is an individual or a business.
enum CustomerType {
  person
  business
}

model Driver {
  id           String @id @default(uuid())
  publicId     String @unique // short code shown on QR / typed by customers (e.g. "5HQN7")
  email        String @unique
  passwordHash String
  role         Role   @default(driver)

  // Profile (mirrors frontend Driver interface)
  name        String
  company     String?
  phone       String?
  photoUrl    String?
  vanPhotoUrl String?
  city        String?
  tagline     String?
  verified    Boolean @default(false)
  yearsActive Int     @default(0)
  deliveries  Int     @default(0)

  // Marketplace profile + location (UK postcode geocoded via postcodes.io).
  // NOTE: `Driver` is the platform's "professional" entity — it can now belong
  // to one or more service categories (Cleaner, Gardener, Driver, …).
  bio       String?
  postcode  String?
  latitude  Float?
  longitude Float?

  // Stripe / billing
  stripeAccountId      String?            @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(none)
  stripeOnboarded      Boolean            @default(false)
  isActive             Boolean            @default(false)
  // When set + still active, the sub is cancelled but paid until this date.
  subscriptionCancelAtPeriodEnd Boolean   @default(false)
  subscriptionCurrentPeriodEnd  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tips       Tip[]
  categories ServiceCategory[]  @relation("DriverCategories")
  jobUnlocks JobContactUnlock[]
  reviews    Review[]
  hiredJobs  Job[]              @relation("JobHired")
}

model Tip {
  id       String @id @default(uuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  amount   Int // pence
  currency String    @default("gbp")
  rating   Int? // 1..5
  status   TipStatus @default(pending)

  customerName    String?
  customerAddress String?
  message         String?

  stripePaymentIntentId String? @unique

  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// A service/occupation professionals can offer and customers can search by.
model ServiceCategory {
  id          String  @id @default(uuid())
  slug        String  @unique // e.g. "cleaner", "delivery-driver"
  name        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionals Driver[] @relation("DriverCategories")
  jobs          Job[]

  @@index([active])
}

// Service-seeker account (individual or business). No subscription — free.
model Customer {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  phone        String?
  type         CustomerType @default(person)
  companyName  String?

  // Optional home/business location for defaulting a job's area.
  postcode  String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs    Job[]
  reviews Review[]
}

// A job opportunity posted by a customer, visible to professionals in the
// matching category. Contact details live on the Customer and are revealed to
// subscribed professionals.
model Job {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  title       String
  description String
  status      JobStatus @default(open)

  // Which professional the customer says they hired (set when the customer
  // marks the job "found my professional"). Optional — off-platform hires stay
  // null. Powers History + a targeted "leave a review".
  hiredDriverId String?
  hiredDriver   Driver? @relation("JobHired", fields: [hiredDriverId], references: [id], onDelete: SetNull)

  // Location (UK postcode geocoded to lat/lng for distance search).
  addressLine String?
  postcode    String
  latitude    Float?
  longitude   Float?

  // Scheduling / commercials (kept flexible for Phase 1).
  workingDays  String[] // e.g. ["mon","tue","wed","thu","fri"]
  workingHours String? // e.g. "After 5:00 PM, 3 hours/day"
  budget       String? // free-text, e.g. "£15/hr"

  // How many professionals may unlock this job's contact details. Null = no
  // limit. Once the number of unlocks reaches it, the job reads "Quotes full"
  // to other pros; the customer can raise it by editing the job.
  maxContacts Int?

  // The customer confirmed, when posting, that SelfeConnect may share their
  // contact details with relevant professionals. Recorded for the audit trail.
  contactConsentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unlocks JobContactUnlock[]
  reviews Review[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

// A customer's rating + written review of a professional. Decoupled from tips:
// a customer can rate and review without paying (tip is a separate, optional
// action). One review per customer per professional (re-submitting updates it).
model Review {
  id       String @id @default(uuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // Null for a review left by scanning the QR code, where the customer has no
  // account — which is the whole point of the QR: no app, no sign-up, seconds.
  // A review with a customer attached is the one we can call "verified".
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // What an anonymous reviewer chose to call themselves, if anything.
  authorName String?
  // A salted hash of the reviewer's IP — never the address itself. Used only to
  // stop one person spraying a professional with reviews (or a professional
  // farming their own). Nothing here identifies a person.
  authorIpHash String?

  // Optional link to the job the customer hired for — makes the review
  // "verified — hired on SelfeConnect".
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  rating  Int // 1..5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per customer per professional. Postgres treats NULLs as
  // distinct, so anonymous QR reviews are not limited by this.
  @@unique([driverId, customerId])
  @@index([driverId])
  @@index([driverId, authorIpHash])
}

// Records when a professional unlocked a job's contact details (analytics +
// "already unlocked" UX). Access itself is gated by an active subscription.
model JobContactUnlock {
  id       String @id @default(uuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobId, driverId])
  @@index([driverId])
}
