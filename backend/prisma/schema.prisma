// TipVan backend schema. Field names mirror the frontend's TypeScript types
// (Driver / Tip) so the API can return shapes the UI already expects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  driver
  admin
}

enum SubscriptionStatus {
  none
  trialing
  active
  past_due
  canceled
}

enum TipStatus {
  pending
  succeeded
  failed
  refunded
}

// A QR transaction is either a gratuity (tip) or a direct payment for work. Same
// rails — 100% to the professional — but tracked apart so their earnings can
// show the two separately.
enum TipType {
  tip
  payment
}

// The job lifecycle. `open` = posted and accepting quotes (the initial state);
// `closed` is a legacy terminal state kept for jobs created before the
// lifecycle existed. Derived stages the dashboard also shows — "quoted" (has
// quotes), "paid" (has a payment), "reviewed" (has a review) — are computed
// from related rows, not stored here, since they aren't mutually exclusive.
enum JobStatus {
  open // posted, accepting quotes
  hired // customer hired a professional
  in_progress // work under way
  completed // work finished
  cancelled // cancelled by customer or professional
  closed // legacy terminal state (pre-lifecycle jobs)
}

// Whether a service-seeker account is an individual or a business.
enum CustomerType {
  person
  business
}

model Driver {
  id           String @id @default(uuid())
  publicId     String @unique // short code shown on QR / typed by customers (e.g. "5HQN7")
  email        String @unique
  passwordHash String
  role         Role   @default(driver)

  // Profile (mirrors frontend Driver interface)
  name        String
  company     String?
  phone       String?
  photoUrl    String?
  vanPhotoUrl String?
  city        String?
  tagline     String?
  verified    Boolean @default(false)
  yearsActive Int     @default(0)
  deliveries  Int     @default(0)

  // Marketplace profile + location (UK postcode geocoded via postcodes.io).
  // NOTE: `Driver` is the platform's "professional" entity — it can now belong
  // to one or more service categories (Cleaner, Gardener, Driver, …).
  bio       String?
  postcode  String?
  latitude  Float?
  longitude Float?

  // Stripe / billing
  stripeAccountId      String?            @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(none)
  stripeOnboarded      Boolean            @default(false)
  isActive             Boolean            @default(false)
  // When set + still active, the sub is cancelled but paid until this date.
  subscriptionCancelAtPeriodEnd Boolean   @default(false)
  subscriptionCurrentPeriodEnd  DateTime?
  // One of the first N professionals to subscribe — they keep the launch rate
  // for as long as the subscription stays live. Set when checkout is started;
  // the spot is only counted as taken once the subscription actually exists.
  foundingMember Boolean @default(false)

  // Email: verification, and whether they want job alerts. The unsubscribe
  // token lets a one-click opt-out work without logging in.
  emailVerifiedAt   DateTime?
  notifyNewJobs     Boolean @default(true)
  unsubscribeToken  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tips       Tip[]
  categories ServiceCategory[]  @relation("DriverCategories")
  jobUnlocks JobContactUnlock[]
  quotes     Quote[]
  messages   Message[]
  notifications Notification[]
  reviews    Review[]
  hiredJobs  Job[]              @relation("JobHired")
}

model Tip {
  id       String @id @default(uuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  amount   Int // pence
  currency String    @default("gbp")
  type     TipType   @default(tip)
  rating   Int? // 1..5 — only meaningful for a tip; a payment carries no review
  status   TipStatus @default(pending)

  customerName    String?
  customerAddress String?
  message         String?

  stripePaymentIntentId String? @unique

  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// A service/occupation professionals can offer and customers can search by.
model ServiceCategory {
  id          String  @id @default(uuid())
  slug        String  @unique // e.g. "cleaner", "delivery-driver"
  name        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionals Driver[] @relation("DriverCategories")
  jobs          Job[]

  @@index([active])
}

// Service-seeker account (individual or business). No subscription — free.
model Customer {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  phone        String?
  type         CustomerType @default(person)
  companyName  String?

  // Optional home/business location for defaulting a job's area.
  postcode  String?
  latitude  Float?
  longitude Float?

  emailVerifiedAt   DateTime?
  notifyJobUpdates  Boolean @default(true)
  unsubscribeToken  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs          Job[]
  reviews       Review[]
  notifications Notification[]
}

// A single-use, short-lived token for resetting a password or confirming an
// email address. The token itself is never stored — only a SHA-256 hash — so a
// leaked database can't be used to seize accounts.
enum TokenPurpose {
  password_reset
  email_verify
}

enum AccountKind {
  professional
  customer
}

model AuthToken {
  id        String       @id @default(uuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  kind      AccountKind
  // Points at either a Driver or a Customer, depending on `kind`.
  accountId String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([accountId, purpose])
  @@index([expiresAt])
}

// A job opportunity posted by a customer, visible to professionals in the
// matching category. Contact details live on the Customer and are revealed to
// subscribed professionals.
model Job {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  title       String
  description String
  status      JobStatus @default(open)

  // Photos of the job (URLs), so professionals can quote accurately without a
  // site visit. Optional. When the customer needs it done, kept as a simple,
  // human phrase ("As soon as possible", "Within a week", "I'm flexible", …).
  photos String[] @default([])
  timing String?

  // Which professional the customer says they hired (set when the customer
  // marks the job "found my professional"). Optional — off-platform hires stay
  // null. Powers History + a targeted "leave a review".
  hiredDriverId String?
  hiredDriver   Driver? @relation("JobHired", fields: [hiredDriverId], references: [id], onDelete: SetNull)

  // Location (UK postcode geocoded to lat/lng for distance search).
  addressLine String?
  postcode    String
  latitude    Float?
  longitude   Float?

  // Scheduling / commercials (kept flexible for Phase 1).
  workingDays  String[] // e.g. ["mon","tue","wed","thu","fri"]
  workingHours String? // e.g. "After 5:00 PM, 3 hours/day"
  budget       String? // free-text, e.g. "£15/hr"

  // How many professionals may unlock this job's contact details. Null = no
  // limit. Once the number of unlocks reaches it, the job reads "Quotes full"
  // to other pros; the customer can raise it by editing the job.
  maxContacts Int?

  // The customer confirmed, when posting, that SelfeConnect may share their
  // contact details with relevant professionals. Recorded for the audit trail.
  contactConsentAt DateTime?

  // Lifecycle timestamps — set as the job moves through its stages. They give
  // the audit trail and let each dashboard show "hired 2 days ago", etc.
  hiredAt      DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unlocks  JobContactUnlock[]
  quotes   Quote[]
  messages Message[]
  reviews  Review[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

// A customer's rating + written review of a professional. Decoupled from tips:
// a customer can rate and review without paying (tip is a separate, optional
// action). One review per customer per professional (re-submitting updates it).
model Review {
  id       String @id @default(uuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // Null for a review left by scanning the QR code, where the customer has no
  // account — which is the whole point of the QR: no app, no sign-up, seconds.
  // A review with a customer attached is the one we can call "verified".
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // What an anonymous reviewer chose to call themselves, if anything.
  authorName String?
  // A salted hash of the reviewer's IP — never the address itself. Used only to
  // stop one person spraying a professional with reviews (or a professional
  // farming their own). Nothing here identifies a person.
  authorIpHash String?

  // Optional link to the job the customer hired for — makes the review
  // "verified — hired on SelfeConnect".
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  rating  Int // 1..5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per customer per professional. Postgres treats NULLs as
  // distinct, so anonymous QR reviews are not limited by this.
  @@unique([driverId, customerId])
  @@index([driverId])
  @@index([driverId, authorIpHash])
}

// A professional's structured response to a job — a price (optional; some work
// needs a visit first) plus a short pitch. One per pro per job; re-submitting
// updates it. Submitting a quote also unlocks the job's contact (see
// JobContactUnlock), so quoting is the richer expression of "I'm interested".
model Quote {
  id       String @id @default(uuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  amount  Int? // pence; null = "will confirm after a look"
  message String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, driverId])
  @@index([jobId])
  @@index([driverId])
}

// An in-app notification for either a professional or a customer (exactly one
// recipient FK is set). Generated on the events people care about — a new
// quote, a new message, being hired — and deep-links to the job.
enum NotificationKind {
  quote
  message
  hired
}

model Notification {
  id String @id @default(uuid())

  driverId String?
  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  title String
  body  String?
  jobId String? // deep-link target (not a FK: the job may be deleted)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([driverId, readAt])
  @@index([customerId, readAt])
}

// One message in the per-job conversation between a customer and one pro. A
// thread is the set of messages sharing (jobId, driverId) — the customer has a
// separate thread with each pro, and pros never see each other. `fromCustomer`
// says who sent it; `readAt` powers unread badges.
model Message {
  id       String @id @default(uuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  fromCustomer Boolean
  body         String
  readAt       DateTime?

  createdAt DateTime @default(now())

  @@index([jobId, driverId])
  @@index([driverId])
}

// Records when a professional unlocked a job's contact details (analytics +
// "already unlocked" UX). Access itself is gated by an active subscription.
model JobContactUnlock {
  id       String @id @default(uuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobId, driverId])
  @@index([driverId])
}
