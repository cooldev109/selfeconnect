# Backend env — copy to .env for local dev. Real .env is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tipvan_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
PUBLIC_URL="http://localhost:8080"
CORS_ORIGIN="http://localhost:8080"
UPLOAD_DIR="./uploads"
# Stripe (leave STRIPE_SECRET_KEY empty to run in mock mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Founding-member pricing. The first FOUNDING_MEMBER_CAP professionals to
# subscribe get the founding price and keep it for as long as they stay
# subscribed; everyone after them gets the standard price. Both Stripe prices
# must exist before the founding places run out.
STRIPE_FOUNDING_PRICE_ID=""    # falls back to STRIPE_SUBSCRIPTION_PRICE_ID
STRIPE_STANDARD_PRICE_ID=""
FOUNDING_MEMBER_CAP=100
FOUNDING_PRICE_GBP=5.49
STANDARD_PRICE_GBP=9.49
